rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Emails com acesso de admin garantido (mantém igual a VITE_ADMIN_EMAILS no .env)
    function adminEmails() {
      return ['shift.angola@gmail.com'];
    }

    function signedIn() { return request.auth != null; }
    function isAdminEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in adminEmails();
    }
    function isAdmin() {
      return isAdminEmail() || (signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Produtos: leitura pública, escrita só admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Comentários: leitura pública; criar só autenticado em nome próprio; apagar o próprio ou admin
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if false;
      }
    }

    // Fotos grandes dos produtos (data URL JPEG): leitura pública, escrita só admin
    match /images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Encomendas: qualquer pessoa pode criar (checkout sem conta); ler só o dono ou admin
    match /orders/{orderId} {
      allow create: if request.resource.data.total is number
        && request.resource.data.items is list
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Marcações: qualquer pessoa pode criar; ler só o dono ou admin
    match /appointments/{apptId} {
      allow create: if request.resource.data.name is string && request.resource.data.phone is string
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Utilizadores: cada um lê/cria o seu; o campo role só o admin altera
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId
        && (request.resource.data.role == 'cliente' || (request.resource.data.role == 'admin' && isAdminEmail()));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
  }
}
