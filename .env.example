# Copie para .env e preencha com os dados do projecto Firebase (Consola > Definições do projecto > As suas apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Emails que recebem acesso ao painel de admin automaticamente (separados por vírgula)
VITE_ADMIN_EMAILS=

# Contacto
VITE_WHATSAPP=244900000000
VITE_PHONE_DISPLAY=+244 900 000 000
